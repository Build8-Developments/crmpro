NODE_ENV=development
PORT=3100

DATABASE_URL=
REDIS_URL=

# Tenant CRM API (used for System health probes + optional metrics snapshot)
TENANT_API_URL=http://localhost:3000/api/v1
# Must match apps/api INTERNAL_MONITORING_KEY to pull queues/workers/HTTP metrics
# INTERNAL_MONITORING_KEY=change-me-to-a-long-random-string
# STUCK_JOB_TIMEOUT_MINUTES=15

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRATION=15m

JWT_REFRESH_EXPIRATION=30d

# Comma-separated allowed origins for CORS. Required: an empty or missing value
# denies all cross-origin requests rather than reflecting the caller's origin.
CORS_ORIGINS=http://localhost:3002
# Shown on each tenant in the admin app. Required in production.
# Production: https://{slug}.nomow.app   Staging: https://{slug}-staging.nomow.app
WORKSPACE_URL_TEMPLATE=http://{slug}.localhost:3001
