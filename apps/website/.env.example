# Public website (nomow.app). NEXT_PUBLIC_* values are baked in at build time.

# The site's own origin: canonical URLs, hreflang, sitemap and Open Graph images.
#   production https://nomow.app (see docs/website/README.md for staging)
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# "Sign in" for existing customers: the CRM's "find my workspace" page (apps/web).
# Empty hides every "Sign in" link (the public site before production exists).
NEXT_PUBLIC_FIND_WORKSPACE_URL=http://localhost:3001/login

# Public contact address (footer, and the fallback when the demo form can't send).
NEXT_PUBLIC_CONTACT_EMAIL=hello@nomow.app

# Demo requests (src/features/demo/actions.ts). Server-side only; never NEXT_PUBLIC.
# Either as leads in Nomow's own workspace through the inbound leads API
# (docs/api/inbound-leads.md)...
DEMO_LEADS_URL=
DEMO_LEADS_API_KEY=
# ...or, until production has that workspace, as an email to the team over SMTP.
DEMO_EMAIL_TO=
SITE_MAIL_FROM=Nomow Website <no-reply@mail.nomow.app>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# With neither, development logs the request instead of sending it.
