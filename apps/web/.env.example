# Same-origin API path (proxied to Nest via next.config rewrites).
# Do not point the browser at http://localhost:3000 — cross-port cookies are unreliable.
NEXT_PUBLIC_API_URL=/api/v1
API_PROXY_TARGET=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Socket.io gateway origin (the Next rewrite does not proxy /socket.io).
# Required in production; e.g. https://api.example.com
NEXT_PUBLIC_SSE_URL=

# Workspace hosts: each agency signs in on its own address; the apex is
# "find my workspace". Must match the API's WORKSPACE_URL_TEMPLATE.
# Locally *.localhost resolves to this machine: http://prime-estates.localhost:3001
#   production  https://{slug}.nomow.app          apex https://nomow.app
#   staging     https://{slug}-staging.nomow.app  apex https://staging.nomow.app
NEXT_PUBLIC_WORKSPACE_URL_TEMPLATE=http://{slug}.localhost:3001
NEXT_PUBLIC_APEX_URL=http://localhost:3001
