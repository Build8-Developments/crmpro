generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum FileAssetCategory {
  AVATAR
  LEAD_ATTACHMENT
  PROJECT_BROCHURE
  IMPORT_FILE
  EXPORT_FILE
  OTHER
}

enum LeadStatus {
  OPEN
  ARCHIVED
}

enum PipelineCloseType {
  WON
  LOST
}

enum InterestLevel {
  LOW
  MEDIUM
  HIGH
  HOT
}

enum LeadActivityEventType {
  LEAD_CREATED
  LEAD_UPDATED
  STAGE_CHANGED
  ASSIGNED
  REASSIGNED
  UNASSIGNED
  NOTE_ADDED
  NOTE_UPDATED
  NOTE_DELETED
  PROJECT_LINKED
  PROJECT_UNLINKED
  CALL_LOGGED
  EMAIL_LOGGED
  WHATSAPP_LOGGED
  STATUS_ARCHIVED
  STATUS_RESTORED
  FILE_ATTACHED
  FILE_DELETED
  TASK_CREATED
  TASK_COMPLETED
  TASK_ASSIGNED
  TASK_CANCELLED
}

enum AuditActorType {
  USER
  SYSTEM
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL_SUCCESS
}

enum ExportFormat {
  CSV
  XLSX
  PDF
}

enum ExportType {
  LEADS
  PROJECTS
  DEVELOPERS
  ACTIVITIES
}

enum NotificationType {
  LEAD_ASSIGNED
  IMPORT_COMPLETED
  EXPORT_COMPLETED
  LEAD_STAGE_CHANGED
  LEAD_WON
  LEAD_LOST
  FILE_DELETED
  SYSTEM
  SECURITY
  REMINDER
  TASK_ASSIGNED
  TASK_DUE
  TASK_OVERDUE
  TASK_COMPLETED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum NotificationPreferenceCategory {
  LEAD_ASSIGNED
  IMPORT_COMPLETED
  EXPORT_COMPLETED
  PIPELINE_UPDATES
  MARKETING
  SYSTEM
  SECURITY
  TASK_UPDATES
}

model SubscriptionPlan {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  maxUsers        Int
  maxStorageBytes BigInt   @db.BigInt
  maxLeads        Int
  maxProjects     Int
  featureFlags    Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenants Tenant[]
}

model Tenant {
  id                 String       @id @default(uuid()) @db.Uuid
  name               String
  slug               String       @unique
  status             TenantStatus @default(TRIAL)
  subscriptionPlanId String       @db.Uuid
  storageUsedBytes   BigInt       @default(0) @db.BigInt
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  subscriptionPlan SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])
  roles            Role[]
  users            User[]
  fileAssets       FileAsset[]
  developers       Developer[]
  projects         Project[]
  leadSources      LeadSource[]
  pipelines        Pipeline[]
  leads            Lead[]
  auditLogs        AuditLog[]
  importJobs       ImportJob[]
  exportJobs       ExportJob[]
  notifications         Notification[]

  @@index([subscriptionPlanId])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  roleId       String    @db.Uuid
  name         String
  email        String
  phone        String?
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  role               Role          @relation(fields: [roleId], references: [id])
  uploadedFileAssets FileAsset[]   @relation("UploadedFiles")
  avatarFileAssets   FileAsset[]   @relation("UserAvatar")
  sessions           UserSession[]
  assignedLeads      Lead[]        @relation("AssignedLeads")
  leadActivities     LeadActivity[]
  leadNotes          LeadNote[]
  auditLogs          AuditLog[]
  importJobs         ImportJob[]
  exportJobs         ExportJob[]
  notifications      Notification[]        @relation("NotificationRecipient")
  createdNotifications Notification[]      @relation("NotificationCreator")
  notificationPreferences NotificationPreference[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([roleId])
}

model UserSession {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  hashedRefreshToken String
  deviceName         String?
  ipAddress          String?
  userAgent          String?
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Developer {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  projects Project[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  developerId String    @db.Uuid
  name        String
  location    String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant              Tenant                @relation(fields: [tenantId], references: [id])
  developer           Developer             @relation(fields: [developerId], references: [id])
  fileAssets          FileAsset[]
  leadProjectInterests LeadProjectInterest[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([developerId])
}

model LeadSource {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  leads  Lead[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Pipeline {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  stages PipelineStage[]
  leads  Lead[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model PipelineStage {
  id         String             @id @default(uuid()) @db.Uuid
  /// Denormalized copy for fast tenant filters — not a FK relation to Tenant
  tenantId   String             @db.Uuid
  pipelineId String             @db.Uuid
  name       String
  color      String?
  sortOrder  Int
  isSystem   Boolean            @default(false)
  isClosed   Boolean            @default(false)
  closeType  PipelineCloseType?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@unique([pipelineId, sortOrder])
  @@unique([pipelineId, name])
  @@index([tenantId])
  @@index([pipelineId, sortOrder])
}

model Lead {
  id                      String     @id @default(uuid()) @db.Uuid
  tenantId                String     @db.Uuid
  sourceId                String?    @db.Uuid
  pipelineId              String     @db.Uuid
  pipelineStageId         String     @db.Uuid
  assignedUserId          String?    @db.Uuid
  status                  LeadStatus @default(OPEN)
  fullName                String
  primaryPhone            String
  primaryPhoneNormalized  String
  secondaryPhone          String?
  secondaryPhoneNormalized String?
  email                   String?
  budgetMin               Decimal?   @db.Decimal(14, 2)
  budgetMax               Decimal?   @db.Decimal(14, 2)
  notesSummary            String?
  customFields            Json?
  lastContactedAt         DateTime?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  deletedAt               DateTime?

  tenant                Tenant                @relation(fields: [tenantId], references: [id])
  source                LeadSource?           @relation(fields: [sourceId], references: [id])
  pipeline              Pipeline              @relation(fields: [pipelineId], references: [id])
  pipelineStage         PipelineStage         @relation(fields: [pipelineStageId], references: [id])
  assignedUser          User?                 @relation("AssignedLeads", fields: [assignedUserId], references: [id])
  fileAssets            FileAsset[]
  activities            LeadActivity[]
  notes                 LeadNote[]
  leadProjectInterests  LeadProjectInterest[]

  @@index([tenantId, pipelineStageId, assignedUserId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([tenantId, primaryPhoneNormalized])
  @@index([tenantId, secondaryPhoneNormalized])
  @@index([pipelineId])
  @@index([pipelineStageId])
  @@index([sourceId])
  @@index([assignedUserId])
}

model LeadProjectInterest {
  leadId        String         @db.Uuid
  projectId     String         @db.Uuid
  interestLevel InterestLevel?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([leadId, projectId])
  @@index([projectId])
}

model LeadActivity {
  id          String                @id @default(uuid()) @db.Uuid
  /// Denormalized copy for fast tenant filters — not a FK relation to Tenant
  tenantId    String                @db.Uuid
  leadId      String                @db.Uuid
  actorUserId String?               @db.Uuid
  eventType   LeadActivityEventType
  metadata    Json                  @default("{}")
  createdAt   DateTime              @default(now())

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([leadId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
}

model LeadNote {
  id        String    @id @default(uuid()) @db.Uuid
  /// Denormalized copy for fast tenant filters — not a FK relation to Tenant
  tenantId  String    @db.Uuid
  leadId    String    @db.Uuid
  authorId  String    @db.Uuid
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([leadId])
  @@index([tenantId])
  @@index([authorId])
}

model FileAsset {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @db.Uuid
  uploadedByUserId String            @db.Uuid
  avatarForUserId  String?           @db.Uuid
  category         FileAssetCategory
  objectKey        String            @unique
  originalFilename String
  mimeType         String
  sizeBytes        BigInt            @db.BigInt
  leadId           String?           @db.Uuid
  projectId        String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  uploadedBy User        @relation("UploadedFiles", fields: [uploadedByUserId], references: [id])
  avatarFor  User?       @relation("UserAvatar", fields: [avatarForUserId], references: [id])
  lead       Lead?       @relation(fields: [leadId], references: [id])
  project    Project?    @relation(fields: [projectId], references: [id])
  importJobs ImportJob[]
  exportJobs ExportJob[]

  @@index([tenantId])
  @@index([tenantId, category])
  @@index([uploadedByUserId])
  @@index([avatarForUserId])
  @@index([leadId])
  @@index([projectId])
}

model FileUploadIntent {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  userId           String   @db.Uuid
  objectKey        String   @unique
  originalFilename String
  mimeType         String
  sizeBytes        BigInt   @db.BigInt
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([tenantId, userId])
  @@index([expiresAt])
}

model AuditLog {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  actorType   AuditActorType
  actorUserId String?        @db.Uuid
  entityType  String
  entityId    String         @db.Uuid
  action      String
  metadata    Json           @default("{}")
  createdAt   DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User?  @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([actorUserId])
}

model ImportJob {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @db.Uuid
  createdByUserId String     @db.Uuid
  fileAssetId     String     @db.Uuid
  status          JobStatus  @default(PENDING)
  totalRows       Int        @default(0)
  processedRows   Int        @default(0)
  successfulRows  Int        @default(0)
  failedRows      Int        @default(0)
  errorSummary    Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  completedAt     DateTime?

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  createdBy User      @relation(fields: [createdByUserId], references: [id])
  fileAsset FileAsset @relation(fields: [fileAssetId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([createdByUserId])
  @@index([fileAssetId])
}

model ExportJob {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  createdByUserId String       @db.Uuid
  fileAssetId     String?      @db.Uuid
  exportType      ExportType
  format          ExportFormat @default(CSV)
  filters         Json         @default("{}")
  status          JobStatus    @default(PENDING)
  progress        Int          @default(0)
  rowCount        Int?
  errorMessage    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  completedAt     DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  createdBy User       @relation(fields: [createdByUserId], references: [id])
  fileAsset FileAsset? @relation(fields: [fileAssetId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([createdByUserId])
  @@index([fileAssetId])
  @@index([exportType])
}

model Notification {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @db.Uuid
  recipientUserId String               @db.Uuid
  type            NotificationType
  title           String
  message         String
  metadata        Json                 @default("{}")
  priority        NotificationPriority @default(NORMAL)
  status          NotificationStatus   @default(UNREAD)
  readAt          DateTime?
  createdAt       DateTime             @default(now())
  expiresAt       DateTime?
  createdByUserId String?              @db.Uuid
  deletedAt       DateTime?

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  recipient User   @relation("NotificationRecipient", fields: [recipientUserId], references: [id])
  createdBy User?  @relation("NotificationCreator", fields: [createdByUserId], references: [id])

  @@index([tenantId, recipientUserId, status, createdAt(sort: Desc)])
  @@index([tenantId, recipientUserId, deletedAt])
  @@index([recipientUserId, createdAt(sort: Desc)])
}

model NotificationPreference {
  id        String                         @id @default(uuid()) @db.Uuid
  tenantId  String                         @db.Uuid
  userId    String                         @db.Uuid
  category  NotificationPreferenceCategory
  enabled   Boolean                        @default(true)
  createdAt DateTime                       @default(now())
  updatedAt DateTime                       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([tenantId, userId])
}
