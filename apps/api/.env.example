NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crmpro
REDIS_URL=redis://localhost:6379
# Or configure Redis explicitly:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

BULL_PREFIX=crmpro
# BULL_IMPORT_CONCURRENCY=3
# BULL_EXPORT_CONCURRENCY=2
# BULL_JOB_ATTEMPTS=3
# BULL_JOB_BACKOFF_DELAY_MS=3000

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

CORS_ORIGINS=http://localhost:3001,http://localhost:3002

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=crmpro-dev-assets
# AWS_S3_ENDPOINT=http://localhost:9000
