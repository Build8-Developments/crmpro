{
  "name": "@crmpro/shared",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "default": "./dist/auth/index.js"
    },
    "./auth/permissions": {
      "types": "./dist/auth/permissions.d.ts",
      "default": "./dist/auth/permissions.js"
    },
    "./leads": {
      "types": "./dist/leads/index.d.ts",
      "default": "./dist/leads/index.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap/index.d.ts",
      "default": "./dist/bootstrap/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "typesVersions": {
    "*": {
      "auth": ["dist/auth/index.d.ts"],
      "auth/permissions": ["dist/auth/permissions.d.ts"],
      "leads": ["dist/leads/index.d.ts"],
      "bootstrap": ["dist/bootstrap/index.d.ts"]
    }
  }
}
