generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum FileAssetCategory {
  AVATAR
  LOGO
  LEAD_ATTACHMENT
  PROJECT_BROCHURE
  IMPORT_FILE
  EXPORT_FILE
  OTHER
}

enum LeadStatus {
  OPEN
  ARCHIVED
}

enum PipelineCloseType {
  WON
  LOST
}

enum InterestLevel {
  LOW
  MEDIUM
  HIGH
  HOT
}

enum LeadActivityEventType {
  LEAD_CREATED
  LEAD_UPDATED
  STAGE_CHANGED
  ASSIGNED
  REASSIGNED
  UNASSIGNED
  NOTE_ADDED
  NOTE_UPDATED
  NOTE_DELETED
  PROJECT_LINKED
  PROJECT_UNLINKED
  CALL_LOGGED
  EMAIL_LOGGED
  WHATSAPP_LOGGED
  STATUS_ARCHIVED
  STATUS_RESTORED
  FILE_ATTACHED
  FILE_DELETED
  TASK_CREATED
  TASK_COMPLETED
  TASK_ASSIGNED
  TASK_CANCELLED
  INTERACTION_LOGGED
  TASK_RESCHEDULED
  TASK_SKIPPED
  CONTACT_ACCESSED
  SLA_BREACHED
  LEAD_RESUBMITTED
  LEAD_MERGED
  DEAL_RESERVED
  DEAL_CONTRACTED
  DEAL_CANCELLED
  DEAL_UPDATED
}

/// How the client prefers to pay.
enum PaymentPreference {
  CASH
  INSTALLMENTS
  MORTGAGE
  FLEXIBLE
}

/// How the client prefers to be reached.
enum ContactChannelPreference {
  CALL
  WHATSAPP
  EMAIL
  SMS
}

enum ContactTimePreference {
  MORNING
  AFTERNOON
  EVENING
  ANYTIME
}

enum PurchasePurpose {
  LIVING
  INVESTMENT
  VACATION_HOME
}

/// How a touch with a client happened. See docs/product/workflow-engine-spec.md §2.1.
enum InteractionChannel {
  CALL
  WHATSAPP
  MEETING
  SITE_VISIT
  VIDEO_CALL
  EMAIL
  SMS
}

enum InteractionDirection {
  OUTBOUND
  INBOUND
}

/// What came out of a touch. Fixed list on purpose: reports and the
/// playbook rules key off these values.
enum InteractionOutcome {
  NO_ANSWER
  BUSY
  SWITCHED_OFF
  WRONG_NUMBER
  ANSWERED_INTERESTED
  ANSWERED_NOT_NOW
  CALLBACK_REQUESTED
  NOT_INTERESTED
  MEETING_BOOKED
  VISIT_BOOKED
  VISIT_DONE
  OFFER_SENT
  NEGOTIATING
  RESERVED
}

enum TaskType {
  CALL
  WHATSAPP
  MEETING
  SITE_VISIT
  SEND_OFFER
  PAPERWORK
  REVIEW
  OTHER
}

enum TaskPriority {
  URGENT
  HIGH
  NORMAL
  LOW
}

enum TaskOrigin {
  SYSTEM
  SELF
  MANAGER
}

enum TaskStatus {
  OPEN
  DONE
  SKIPPED
  CANCELLED
}

/// Visible, rule-based temperature of a lead (spec §3.3) — not a score.
enum LeadHeat {
  HOT
  WARM
  COLD
}

enum AuditActorType {
  USER
  SYSTEM
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL_SUCCESS
}

enum ExportFormat {
  CSV
  XLSX
  PDF
}

enum ExportType {
  LEADS
  PROJECTS
  DEVELOPERS
  ACTIVITIES
}

enum NotificationType {
  LEAD_ASSIGNED
  IMPORT_COMPLETED
  EXPORT_COMPLETED
  LEAD_STAGE_CHANGED
  LEAD_WON
  LEAD_LOST
  FILE_DELETED
  SYSTEM
  SECURITY
  REMINDER
  TASK_ASSIGNED
  TASK_DUE
  TASK_OVERDUE
  TASK_COMPLETED
  SUPPORT_REPLY
  ESCALATION
  ACHIEVEMENT
}

enum SupportConversationStatus {
  OPEN
  WAITING_ON_USER
  WAITING_ON_ADMIN
  RESOLVED
  CLOSED
}

enum SupportMessageAuthorType {
  USER
  ADMIN
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum NotificationPreferenceCategory {
  LEAD_ASSIGNED
  IMPORT_COMPLETED
  EXPORT_COMPLETED
  PIPELINE_UPDATES
  MARKETING
  SYSTEM
  SECURITY
  TASK_UPDATES
}

enum AdminActorType {
  ADMIN
  SYSTEM
}

enum AdminSecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  TOKEN_REFRESH
  TOKEN_REUSE
  SESSION_REVOKED
  PASSWORD_CHANGED
  SUSPICIOUS_LOGIN
}

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  INSTAPAY
  OTHER
}

enum PaymentFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
  CUSTOM
}

model SubscriptionPlan {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  description     String?
  isActive        Boolean  @default(true)
  defaultPrice    Decimal? @db.Decimal(12, 2)
  currency        String?
  maxUsers        Int?
  maxStorageBytes BigInt?  @db.BigInt
  maxLeads        Int?
  maxProjects     Int?
  featureFlags    Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenants   Tenant[]
  contracts TenantContract[]
}

model Tenant {
  id                 String       @id @default(uuid()) @db.Uuid
  name               String
  slug               String       @unique
  status             TenantStatus @default(TRIAL)
  subscriptionPlanId String       @db.Uuid
  storageUsedBytes   BigInt       @default(0) @db.BigInt
  /// Workspace logo, set by the organization from Settings → General.
  logoFileId         String?      @unique @db.Uuid
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  subscriptionPlan SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])
  logoFile         FileAsset?       @relation("TenantLogo", fields: [logoFileId], references: [id], onDelete: SetNull)
  settings         TenantSettings?
  contracts        TenantContract[]
  roles            Role[]
  users            User[]
  fileAssets       FileAsset[]
  developers       Developer[]
  projects         Project[]
  leadSources      LeadSource[]
  pipelines        Pipeline[]
  leads            Lead[]
  auditLogs        AuditLog[]
  importJobs       ImportJob[]
  exportJobs       ExportJob[]
  notifications         Notification[]
  supportNotes          TenantNote[]
  supportConversations  SupportConversation[]
  fileFolders           FileFolder[]
  lostReasons           LostReason[]
  interactions          Interaction[]
  tasks                 Task[]
  teams                 Team[]
  savedViews            SavedView[]
  apiKeys               ApiKey[]
  deals                 Deal[]
  targets               Target[]
  sourceSpends          SourceSpend[]
  userDailyStats        UserDailyStat[]
  userAchievements      UserAchievement[]

  @@index([subscriptionPlanId])
}

/// Organization-wide settings. One row per tenant, created at provisioning
/// (and backfilled for existing tenants) with defaults. Typed columns on
/// purpose: validated by the DB and never drifting from the API/UI.
/// See docs/product/settings-spec.md.
model TenantSettings {
  tenantId        String   @id @db.Uuid
  /// ISO-3166 alpha-2. Default country for phone numbers without a code.
  countryCode     String   @default("EG")
  /// IANA timezone used for "today", reports and reminders.
  timezone        String   @default("Africa/Cairo")
  /// ISO-4217 currency for budgets, prices and deals.
  currency        String   @default("EGP")
  /// 0 = Sunday … 6 = Saturday.
  weekStartsOn    Int      @default(6)
  /// Days the team works (0 = Sunday … 6 = Saturday). SLA clocks only run on them.
  workingDays            Int[]    @default([0, 1, 2, 3, 4, 6])
  /// Working hours as minutes after midnight in `timezone` (600 = 10:00).
  workdayStartMinute     Int      @default(600)
  workdayEndMinute       Int      @default(1140)
  /// A newly assigned lead must be called within this many working minutes.
  firstContactSlaMinutes Int      @default(15)
  /// …and the manager is alerted after this many.
  escalateAfterMinutes   Int      @default(30)
  /// Interactions per agent per day the Today screen aims for.
  dailyInteractionGoal   Int      @default(25)
  /// Agents see the top 3 and their own rank on My performance.
  showLeaderboardToAgents Boolean @default(true)
  updatedAt       DateTime @updatedAt
  updatedByUserId String?  @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       User[]

  // (tenantId, name) is unique among live rows via a partial unique index
  // (WHERE "deletedAt" IS NULL) created in migration
  // 20261116121000_partial_unique_names. It is not expressible here.
  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  roleId       String    @db.Uuid
  name         String
  email        String
  phone        String?
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  teamId       String?   @db.Uuid
  /// Set when the user was invited by email; inviteAcceptedAt once they chose a password.
  invitedAt        DateTime?
  inviteAcceptedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  role               Role          @relation(fields: [roleId], references: [id])
  team               Team?         @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  savedViews         SavedView[]
  tokens             UserToken[]
  apiKeys            ApiKey[]
  ledTeams           Team[]        @relation("TeamLeader")
  uploadedFileAssets FileAsset[]   @relation("UploadedFiles")
  avatarFileAssets   FileAsset[]   @relation("UserAvatar")
  sessions           UserSession[]
  assignedLeads      Lead[]        @relation("AssignedLeads")
  leadActivities     LeadActivity[]
  leadNotes          LeadNote[]
  auditLogs          AuditLog[]
  importJobs         ImportJob[]
  exportJobs         ExportJob[]
  notifications      Notification[]        @relation("NotificationRecipient")
  createdNotifications Notification[]      @relation("NotificationCreator")
  notificationPreferences NotificationPreference[]
  supportConversations SupportConversation[] @relation("SupportConversationCreator")
  supportMessages      SupportMessage[]      @relation("SupportMessageUserAuthor")
  fileFoldersCreated   FileFolder[]          @relation("FoldersCreated")
  interactions         Interaction[]
  assignedTasks        Task[]                @relation("TaskAssignee")
  createdTasks         Task[]                @relation("TaskCreator")
  agentDeals           Deal[]                @relation("DealAgent")
  createdDeals         Deal[]                @relation("DealCreator")
  targets              Target[]              @relation("TargetUser")
  dailyStats           UserDailyStat[]
  achievements         UserAchievement[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([roleId])
  @@index([tenantId, teamId])
}

/// A sales team. A user belongs to at most one team. The leader, and members
/// whose role has lead.read-team, see the team's leads plus unassigned ones.
model Team {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  name         String
  leaderUserId String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  leader  User?  @relation("TeamLeader", fields: [leaderUserId], references: [id], onDelete: SetNull)
  members User[] @relation("TeamMembers")

  // (tenantId, lower(name)) is unique among live rows via a partial unique index
  // in the migration.
  @@index([tenantId, deletedAt])
  @@index([leaderUserId])
}

model UserSession {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  hashedRefreshToken String
  deviceName         String?
  ipAddress          String?
  userAgent          String?
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Developer {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  projects Project[]

  // (tenantId, name) is unique among live rows via a partial unique index
  // (WHERE "deletedAt" IS NULL) created in migration
  // 20261116121000_partial_unique_names. It is not expressible here.
  @@index([tenantId])
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  developerId String    @db.Uuid
  name        String
  location    String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant              Tenant                @relation(fields: [tenantId], references: [id])
  developer           Developer             @relation(fields: [developerId], references: [id])
  fileAssets          FileAsset[]
  leadProjectInterests LeadProjectInterest[]
  interactions        Interaction[]
  deals               Deal[]

  // (tenantId, name) is unique among live rows via a partial unique index
  // (WHERE "deletedAt" IS NULL) created in migration
  // 20261116121000_partial_unique_names. It is not expressible here.
  @@index([tenantId])
  @@index([developerId])
}

model LeadSource {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  leads  Lead[]
  spends SourceSpend[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Pipeline {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  stages PipelineStage[]
  leads  Lead[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model PipelineStage {
  id         String             @id @default(uuid()) @db.Uuid
  /// Denormalized copy for fast tenant filters — not a FK relation to Tenant
  tenantId   String             @db.Uuid
  pipelineId String             @db.Uuid
  name       String
  color      String?
  sortOrder  Int
  isSystem   Boolean            @default(false)
  isClosed   Boolean            @default(false)
  closeType  PipelineCloseType?
  /// Icon key from the web's stage icon set (e.g. "phone", "trophy").
  icon       String?
  /// R8: a lead here with no interaction for this many days gets a "revive"
  /// call. Null turns the rule off for the stage.
  staleAfterDays Int?
  /// R9: a lead in this stage longer than this gets a manager review task.
  /// Null turns the rule off for the stage.
  stuckAfterDays Int?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads    Lead[]

  @@unique([pipelineId, sortOrder])
  @@unique([pipelineId, name])
  @@index([tenantId])
  @@index([pipelineId, sortOrder])
}

model Lead {
  id                      String     @id @default(uuid()) @db.Uuid
  tenantId                String     @db.Uuid
  sourceId                String?    @db.Uuid
  pipelineId              String     @db.Uuid
  pipelineStageId         String     @db.Uuid
  assignedUserId          String?    @db.Uuid
  status                  LeadStatus @default(OPEN)
  fullName                String
  primaryPhone            String
  primaryPhoneNormalized  String
  secondaryPhone          String?
  secondaryPhoneNormalized String?
  email                   String?
  budgetMin               Decimal?   @db.Decimal(14, 2)
  budgetMax               Decimal?   @db.Decimal(14, 2)
  notesSummary            String?
  /// Client profile (all optional; filterable, importable, exportable).
  occupation              String?
  residenceArea           String?
  paymentPreference       PaymentPreference?
  contactChannelPreference ContactChannelPreference?
  contactTimePreference   ContactTimePreference?
  purchasePurpose         PurchasePurpose?
  customFields            Json?
  /// Last real touch (Interaction). Written only by interactions.
  lastContactedAt         DateTime?
  /// First outbound touch by the assignee — honest speed-to-lead.
  firstContactedAt        DateTime?
  /// When the lead entered its current stage (stage velocity, stuck deals).
  stageEnteredAt          DateTime   @default(now())
  /// Set on a WON/LOST transition, cleared on reopen.
  closedAt                DateTime?
  /// Earliest open task — "no next step" is `nextTaskDueAt IS NULL`.
  nextTaskDueAt           DateTime?
  /// When the current assignee got the lead (the SLA clock starts here).
  assignedAt              DateTime?
  /// First-contact SLA missed (set once, by the rules engine).
  slaBreachedAt           DateTime?
  /// Caller-supplied id from an inbound integration (idempotency). Unique
  /// per tenant among live leads (partial index in the migration).
  externalId              String?
  /// Import job + 1-based data row that created this lead (retry-safe).
  importJobId             String?    @db.Uuid
  importRowNumber         Int?
  contactAttempts         Int        @default(0)
  unansweredStreak        Int        @default(0)
  heat                    LeadHeat   @default(WARM)
  lostReasonId            String?    @db.Uuid
  lostNote                String?
  /// Set on a duplicate that was merged away (it is soft-deleted too); points
  /// at the surviving lead so old links can redirect.
  mergedIntoId            String?    @db.Uuid
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  deletedAt               DateTime?

  tenant                Tenant                @relation(fields: [tenantId], references: [id])
  mergedInto            Lead?                 @relation("LeadMerges", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedLeads           Lead[]                @relation("LeadMerges")
  lostReason            LostReason?           @relation(fields: [lostReasonId], references: [id])
  interactions          Interaction[]
  tasks                 Task[]
  source                LeadSource?           @relation(fields: [sourceId], references: [id])
  pipeline              Pipeline              @relation(fields: [pipelineId], references: [id])
  pipelineStage         PipelineStage         @relation(fields: [pipelineStageId], references: [id])
  assignedUser          User?                 @relation("AssignedLeads", fields: [assignedUserId], references: [id])
  fileAssets            FileAsset[]
  activities            LeadActivity[]
  notes                 LeadNote[]
  leadProjectInterests  LeadProjectInterest[]
  deals                 Deal[]
  importJob             ImportJob?            @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  @@unique([importJobId, importRowNumber])
  @@index([tenantId, pipelineStageId, assignedUserId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, status])
  @@index([tenantId, primaryPhoneNormalized])
  @@index([tenantId, secondaryPhoneNormalized])
  @@index([pipelineId])
  @@index([pipelineStageId])
  @@index([sourceId])
  @@index([assignedUserId])
  @@index([tenantId, assignedUserId, nextTaskDueAt])
  @@index([lostReasonId])
  @@index([mergedIntoId])
}

/// Why a lead was lost. Tenant-editable list; recyclable reasons bring the
/// lead back as a "re-engage" task after `recycleAfterDays` (spec §2.4).
model LostReason {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  name             String
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  recyclable       Boolean  @default(false)
  recycleAfterDays Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  leads  Lead[]

  @@unique([tenantId, name])
  @@index([tenantId, sortOrder])
}

/// One real touch with a client (spec §2.1).
model Interaction {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @db.Uuid
  leadId          String               @db.Uuid
  userId          String               @db.Uuid
  channel         InteractionChannel
  direction       InteractionDirection @default(OUTBOUND)
  outcome         InteractionOutcome
  durationSeconds Int?
  note            String?
  projectId       String?              @db.Uuid
  occurredAt      DateTime             @default(now())
  createdAt       DateTime             @default(now())

  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id])
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  completedTasks Task[]   @relation("TaskCompletedBy")
  evidence       FileAsset[] @relation("InteractionEvidence")

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, userId, occurredAt(sort: Desc)])
  @@index([leadId, occurredAt(sort: Desc)])
}

/// The next thing someone must do (spec §2.2). At most one OPEN task per
/// (leadId, ruleKey) — enforced by a partial unique index in migration
/// 20261117100000_workflow_records (not expressible here).
model Task {
  id                     String       @id @default(uuid()) @db.Uuid
  tenantId               String       @db.Uuid
  leadId                 String?      @db.Uuid
  assigneeId             String       @db.Uuid
  createdByUserId        String?      @db.Uuid
  type                   TaskType
  title                  String
  dueAt                  DateTime
  isAllDay               Boolean      @default(false)
  priority               TaskPriority @default(NORMAL)
  origin                 TaskOrigin   @default(SELF)
  ruleKey                String?
  status                 TaskStatus   @default(OPEN)
  completedAt            DateTime?
  completedInteractionId String?      @db.Uuid
  skipReason             String?
  snoozeCount            Int          @default(0)
  escalatedAt            DateTime?
  /// When a miss is escalated to the manager (set by SLA rules).
  escalateAt             DateTime?
  reminderSentAt         DateTime?
  overdueNotifiedAt      DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  tenant               Tenant       @relation(fields: [tenantId], references: [id])
  lead                 Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee             User         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy            User?        @relation("TaskCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  completedInteraction Interaction? @relation("TaskCompletedBy", fields: [completedInteractionId], references: [id], onDelete: SetNull)

  @@index([tenantId, assigneeId, status, dueAt])
  @@index([leadId, status])
  @@index([tenantId, status, dueAt])
  @@index([status, dueAt])
  @@index([status, escalateAt])
  @@index([tenantId, ruleKey, createdAt])
}

model LeadProjectInterest {
  leadId        String         @db.Uuid
  projectId     String         @db.Uuid
  interestLevel InterestLevel?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([leadId, projectId])
  @@index([projectId])
}

model LeadActivity {
  id          String                @id @default(uuid()) @db.Uuid
  /// Denormalized copy for fast tenant filters — not a FK relation to Tenant
  tenantId    String                @db.Uuid
  leadId      String                @db.Uuid
  actorUserId String?               @db.Uuid
  eventType   LeadActivityEventType
  metadata    Json                  @default("{}")
  createdAt   DateTime              @default(now())

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([leadId, createdAt(sort: Desc)])
  @@index([tenantId, createdAt(sort: Desc)])
}

model LeadNote {
  id        String    @id @default(uuid()) @db.Uuid
  /// Denormalized copy for fast tenant filters — not a FK relation to Tenant
  tenantId  String    @db.Uuid
  leadId    String    @db.Uuid
  authorId  String    @db.Uuid
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([leadId])
  @@index([tenantId])
  @@index([authorId])
}

model FileAsset {
  id               String            @id @default(uuid()) @db.Uuid
  tenantId         String            @db.Uuid
  uploadedByUserId String            @db.Uuid
  avatarForUserId  String?           @db.Uuid
  category         FileAssetCategory
  objectKey        String            @unique
  originalFilename String
  mimeType         String
  sizeBytes        BigInt            @db.BigInt
  leadId           String?           @db.Uuid
  projectId        String?           @db.Uuid
  /// Gallery folder for user-uploaded files (null = root). System files
  /// (lead attachments, imports, exports, logos) are not placed in folders.
  folderId         String?           @db.Uuid
  /// Small WebP preview (first PDF page / downscaled image), generated
  /// server-side in the background. Null until generated or if unsupported.
  thumbnailObjectKey String?         @unique
  /// Evidence: the logged interaction this lead attachment documents
  /// (reservation form, signed offer…). The file still belongs to the lead.
  interactionId    String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  uploadedBy User        @relation("UploadedFiles", fields: [uploadedByUserId], references: [id])
  avatarFor  User?       @relation("UserAvatar", fields: [avatarForUserId], references: [id])
  lead       Lead?       @relation(fields: [leadId], references: [id])
  project    Project?    @relation(fields: [projectId], references: [id])
  importJobs ImportJob[]
  exportJobs ExportJob[]
  logoForTenant Tenant? @relation("TenantLogo")
  // Restrict: removing a private folder must never drop its files to the
  // unprotected root.
  folder        FileFolder? @relation(fields: [folderId], references: [id], onDelete: Restrict)
  interaction   Interaction? @relation("InteractionEvidence", fields: [interactionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, folderId])
  @@index([interactionId])
  @@index([tenantId, category])
  @@index([uploadedByUserId])
  @@index([avatarForUserId])
  @@index([leadId])
  @@index([projectId])
}

/// Folder in the Files gallery. Nested via parentId. A folder with a
/// passwordHash is private: it and everything below it stay locked until a
/// user unlocks it with the password (per session, time-limited).
model FileFolder {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  parentId        String?   @db.Uuid
  name            String
  /// Argon2 hash. Null = not password-protected (may still inherit a lock).
  passwordHash    String?
  createdByUserId String    @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  parent    FileFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  FileFolder[] @relation("FolderTree")
  createdBy User         @relation("FoldersCreated", fields: [createdByUserId], references: [id])
  files     FileAsset[]

  // Sibling names are unique among live folders (case-insensitive) via a
  // partial expression index in migration 20261116140000_file_folders.
  @@index([tenantId, parentId])
}

model FileUploadIntent {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  userId           String   @db.Uuid
  objectKey        String   @unique
  originalFilename String
  mimeType         String
  sizeBytes        BigInt   @db.BigInt
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@index([tenantId, userId])
  @@index([expiresAt])
}

model AuditLog {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  actorType   AuditActorType @default(USER)
  actorUserId String?        @db.Uuid
  entityType  String
  entityId    String?        @db.Uuid
  action      String
  metadata    Json           @default("{}")
  createdAt   DateTime       @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User?  @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, action])
  @@index([tenantId, entityType])
  @@index([actorUserId])
}

model ImportJob {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @db.Uuid
  createdByUserId String     @db.Uuid
  fileAssetId     String     @db.Uuid
  status          JobStatus  @default(PENDING)
  totalRows       Int        @default(0)
  processedRows   Int        @default(0)
  successfulRows  Int        @default(0)
  failedRows      Int        @default(0)
  /// Rows skipped as duplicates of existing leads (not failures).
  skippedRows     Int        @default(0)
  duplicatePolicy ImportDuplicatePolicy @default(SKIP)
  /// Column mapping and defaults chosen in the import wizard.
  options         Json?
  errorSummary    Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  completedAt     DateTime?

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  createdBy User      @relation(fields: [createdByUserId], references: [id])
  fileAsset FileAsset @relation(fields: [fileAssetId], references: [id])
  leads     Lead[]

  @@index([tenantId])
  @@index([status])
  @@index([createdByUserId])
  @@index([fileAssetId])
}

model ExportJob {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  createdByUserId String       @db.Uuid
  fileAssetId     String?      @db.Uuid
  exportType      ExportType
  format          ExportFormat @default(CSV)
  filters         Json         @default("{}")
  /// The requester's lead visibility, frozen when the export was requested.
  leadScope       Json?
  status          JobStatus    @default(PENDING)
  progress        Int          @default(0)
  rowCount        Int?
  errorMessage    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  completedAt     DateTime?

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  createdBy User       @relation(fields: [createdByUserId], references: [id])
  fileAsset FileAsset? @relation(fields: [fileAssetId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([createdByUserId])
  @@index([fileAssetId])
  @@index([exportType])
}

model Notification {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @db.Uuid
  recipientUserId String               @db.Uuid
  type            NotificationType
  title           String
  message         String
  metadata        Json                 @default("{}")
  priority        NotificationPriority @default(NORMAL)
  status          NotificationStatus   @default(UNREAD)
  readAt          DateTime?
  createdAt       DateTime             @default(now())
  expiresAt       DateTime?
  createdByUserId String?              @db.Uuid
  dedupeKey       String?
  deletedAt       DateTime?

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  recipient User   @relation("NotificationRecipient", fields: [recipientUserId], references: [id])
  createdBy User?  @relation("NotificationCreator", fields: [createdByUserId], references: [id])

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, recipientUserId, status, createdAt(sort: Desc)])
  @@index([tenantId, recipientUserId, deletedAt])
  @@index([recipientUserId, createdAt(sort: Desc)])
}

model NotificationPreference {
  id        String                         @id @default(uuid()) @db.Uuid
  tenantId  String                         @db.Uuid
  userId    String                         @db.Uuid
  category  NotificationPreferenceCategory
  enabled   Boolean                        @default(true)
  /// Also email this category (opt-in; in-app stays the source of truth).
  emailEnabled Boolean                     @default(false)
  createdAt DateTime                       @default(now())
  updatedAt DateTime                       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([tenantId, userId])
}

model PlatformAdmin {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  fullName     String
  roleId       String    @db.Uuid
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role            AdminRole            @relation(fields: [roleId], references: [id])
  sessions        AdminSession[]
  auditLogs       AdminAuditLog[]
  securityEvents  AdminSecurityEvent[]
  authoredNotes       AdminNote[]          @relation("AdminNoteAuthor")
  receivedNotes       AdminNote[]          @relation("AdminNoteTarget")
  authoredTenantNotes TenantNote[]         @relation("TenantNoteAuthor")
  assignedSupportConversations SupportConversation[] @relation("SupportConversationAssignee")
  supportMessages     SupportMessage[]     @relation("SupportMessageAdminAuthor")
  createdContracts    TenantContract[]

  @@index([roleId])
  @@index([isActive])
}

model AdminRole {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  isSystem  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admins      PlatformAdmin[]
  permissions AdminRolePermission[]
}

model AdminPermission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles AdminRolePermission[]
}

model AdminRolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model AdminSession {
  id                 String    @id @default(uuid()) @db.Uuid
  adminId            String    @db.Uuid
  hashedRefreshToken String
  ipAddress          String?
  userAgent          String?
  deviceFingerprint  String?
  deviceName         String?
  country            String?
  city               String?
  expiresAt          DateTime
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AdminAuditLog {
  id            String         @id @default(uuid()) @db.Uuid
  actorAdminId  String?        @db.Uuid
  actorType     AdminActorType
  action        String
  entityType    String
  entityId      String?        @db.Uuid
  ipAddress     String?
  userAgent     String?
  fingerprint   String?
  metadata      Json?
  createdAt     DateTime       @default(now())

  actorAdmin PlatformAdmin? @relation(fields: [actorAdminId], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([actorAdminId])
  @@index([entityType, entityId])
  @@index([action])
}

model AdminSecurityEvent {
  id          String                 @id @default(uuid()) @db.Uuid
  adminId     String?                @db.Uuid
  eventType   AdminSecurityEventType
  severity    SecuritySeverity
  ipAddress   String?
  userAgent   String?
  fingerprint String?
  metadata    Json?
  createdAt   DateTime               @default(now())

  admin PlatformAdmin? @relation(fields: [adminId], references: [id])

  @@index([adminId, createdAt(sort: Desc)])
  @@index([eventType, createdAt(sort: Desc)])
  @@index([severity, createdAt(sort: Desc)])
}

model AdminNote {
  id            String    @id @default(uuid()) @db.Uuid
  targetAdminId String    @db.Uuid
  authorAdminId String    @db.Uuid
  content       String    @db.VarChar(5000)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  targetAdmin PlatformAdmin @relation("AdminNoteTarget", fields: [targetAdminId], references: [id], onDelete: Cascade)
  authorAdmin PlatformAdmin @relation("AdminNoteAuthor", fields: [authorAdminId], references: [id], onDelete: Cascade)

  @@index([targetAdminId, deletedAt])
  @@index([authorAdminId])
}

/// Internal support notes on a tenant workspace (platform operators only).
model TenantNote {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  authorAdminId String    @db.Uuid
  content       String    @db.VarChar(5000)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  authorAdmin PlatformAdmin @relation("TenantNoteAuthor", fields: [authorAdminId], references: [id], onDelete: Cascade)

  @@index([tenantId, deletedAt])
  @@index([authorAdminId])
}

/// User ↔ platform admin support conversation (cross-tenant inbox on admin side).
model SupportConversation {
  id                 String                    @id @default(uuid()) @db.Uuid
  tenantId           String                    @db.Uuid
  createdByUserId    String                    @db.Uuid
  assignedAdminId    String?                   @db.Uuid
  subject            String                    @db.VarChar(200)
  status             SupportConversationStatus @default(OPEN)
  lastMessageAt      DateTime                  @default(now())
  lastMessagePreview String?                   @db.VarChar(280)
  userUnreadCount    Int                       @default(0)
  adminUnreadCount   Int                       @default(0)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  closedAt           DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser User           @relation("SupportConversationCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  assignedAdmin PlatformAdmin? @relation("SupportConversationAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages      SupportMessage[]

  @@index([tenantId, status, lastMessageAt(sort: Desc)])
  @@index([assignedAdminId, status, lastMessageAt(sort: Desc)])
  @@index([status, lastMessageAt(sort: Desc)])
  @@index([createdByUserId])
}

model SupportMessage {
  id             String                   @id @default(uuid()) @db.Uuid
  conversationId String                   @db.Uuid
  tenantId       String                   @db.Uuid
  authorType     SupportMessageAuthorType
  authorUserId   String?                  @db.Uuid
  authorAdminId  String?                  @db.Uuid
  body           String                   @db.VarChar(10000)
  createdAt      DateTime                 @default(now())
  deletedAt      DateTime?

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorUser   User?               @relation("SupportMessageUserAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorAdmin  PlatformAdmin?      @relation("SupportMessageAdminAuthor", fields: [authorAdminId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
}

/// Commercial contract for a tenant. DB enforces at most one ACTIVE row per tenantId (partial unique index).
model TenantContract {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String?          @db.Uuid
  planId           String           @db.Uuid
  contractName     String?
  agreedPrice      Decimal          @db.Decimal(12, 2)
  currency         String
  paymentMethod    PaymentMethod
  paymentFrequency PaymentFrequency
  contractStartAt  DateTime
  contractEndAt    DateTime?
  discountPercent  Int?
  gracePeriodDays  Int?
  autoRenew        Boolean          @default(false)
  notes            String?          @db.VarChar(5000)
  status           ContractStatus   @default(DRAFT)
  createdByAdminId String           @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  tenant         Tenant?          @relation(fields: [tenantId], references: [id])
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])
  createdByAdmin PlatformAdmin    @relation(fields: [createdByAdminId], references: [id])

  @@index([status])
  @@index([planId])
  @@index([tenantId])
  @@index([deletedAt])
}

/// A saved way of looking at a table: filters, sort and display (list/board,
/// columns, density). Views only store settings — results are always computed
/// under the viewer's own lead visibility, so sharing never shares data.
model SavedView {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String   @db.Uuid
  /// Which table the view belongs to ("leads" for now).
  tableKey  String   @default("leads")
  name      String
  filters   Json     @default("{}")
  sort      Json     @default("{}")
  /// { layout: "list" | "board", columns: Record<string, boolean>, density }
  display   Json     @default("{}")
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, tableKey, userId])
  @@index([tenantId, tableKey, isShared])
}

enum UserTokenType {
  PASSWORD_RESET
  INVITE
}

/// Single-use, expiring tokens for password reset and invitations. Only a
/// SHA-256 hash is stored; the raw token only exists in the emailed link.
model UserToken {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  userId    String        @db.Uuid
  type      UserTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([tenantId])
}

enum ImportDuplicatePolicy {
  /// Rows whose phone matches an existing lead are skipped (default).
  SKIP
  /// Rows are imported even when the phone already exists.
  CREATE
}

/// Keys for inbound integrations (website forms, Zapier, ad platforms).
/// Only a SHA-256 hash is stored; the key is shown once at creation.
model ApiKey {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  name            String
  /// First characters of the key, to recognise it in the list.
  prefix          String
  keyHash         String    @unique
  /// Inbound leads get this source (optional).
  sourceId        String?   @db.Uuid
  lastUsedAt      DateTime?
  createdByUserId String    @db.Uuid
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  createdBy User   @relation(fields: [createdByUserId], references: [id])

  @@index([tenantId, revokedAt])
}

// ---------------------------------------------------------------------------
// W3 — money & targets (workflow spec §2.5–2.8)
// ---------------------------------------------------------------------------

enum DealStatus {
  RESERVED
  CONTRACTED
  CANCELLED
}

/// A sale on a won lead (spec §2.5). One live (not cancelled) deal per lead;
/// cancelling it re-opens the lead.
model Deal {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @db.Uuid
  leadId           String     @db.Uuid
  projectId        String?    @db.Uuid
  /// Who gets the credit; defaults to the lead owner.
  agentId          String?    @db.Uuid
  unitType         String
  unitCode         String?
  price            Decimal    @db.Decimal(14, 2)
  /// ISO-4217, copied from the workspace currency when the deal is created.
  currency         String     @default("EGP")
  downPaymentPct   Decimal?   @db.Decimal(5, 2)
  /// Free text for now ("10% down, 8 years quarterly").
  paymentPlan      String?
  commissionPct    Decimal?   @db.Decimal(5, 2)
  /// price × commissionPct, or typed by hand.
  commissionAmount Decimal?   @db.Decimal(14, 2)
  status           DealStatus @default(RESERVED)
  reservedAt       DateTime   @default(now())
  contractedAt     DateTime?
  /// When the contract should be signed (set while doing the paperwork, R10).
  expectedContractAt DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  notes            String?
  createdByUserId  String?    @db.Uuid
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agent     User?    @relation("DealAgent", fields: [agentId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("DealCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, contractedAt])
  @@index([tenantId, reservedAt])
  @@index([tenantId, agentId])
  @@index([leadId])
  @@index([projectId])
}

enum TargetMetric {
  DEALS
  REVENUE
  COMMISSION
  INTERACTIONS
  VISITS
}

/// Monthly goal for one agent, or for the whole workspace when `userId` is
/// null (spec §2.6). Unique per (user | workspace, period, metric) — partial
/// indexes in the migration because NULLs are distinct.
model Target {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  userId          String?      @db.Uuid
  /// Calendar month in the workspace timezone, "YYYY-MM".
  period          String
  metric          TargetMetric
  value           Decimal      @db.Decimal(16, 2)
  updatedByUserId String?      @db.Uuid
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation("TargetUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, period])
}

/// Marketing spend per lead source per month, entered by the owner (spec §2.7).
model SourceSpend {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  sourceId        String   @db.Uuid
  /// Calendar month in the workspace timezone, "YYYY-MM".
  period          String
  amount          Decimal  @db.Decimal(14, 2)
  note            String?
  updatedByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  source LeadSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sourceId, period])
  @@index([tenantId, period])
}

/// One row per user per local day, written by the nightly job and refreshed
/// for "today" on demand (spec §2.8). Additive counters only, so any range is
/// a SUM; averages are stored as total + count.
model UserDailyStat {
  tenantId                 String   @db.Uuid
  userId                   String   @db.Uuid
  /// Local calendar day in the workspace timezone.
  day                      DateTime @db.Date
  interactions             Int      @default(0)
  calls                    Int      @default(0)
  whatsapps                Int      @default(0)
  meetings                 Int      @default(0)
  visits                   Int      @default(0)
  answered                 Int      @default(0)
  tasksDue                 Int      @default(0)
  tasksDone                Int      @default(0)
  tasksOverdue             Int      @default(0)
  tasksSnoozed             Int      @default(0)
  slaHits                  Int      @default(0)
  slaMisses                Int      @default(0)
  firstResponseCount       Int      @default(0)
  firstResponseMinutesTotal Int     @default(0)
  dealsReserved            Int      @default(0)
  dealsContracted          Int      @default(0)
  dealsCancelled           Int      @default(0)
  revenue                  Decimal  @default(0) @db.Decimal(16, 2)
  commission               Decimal  @default(0) @db.Decimal(16, 2)
  computedAt               DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId, day])
  @@index([tenantId, day])
}

/// A badge level a user earned (spec §2.9). Written once when reached, so we
/// can show "unlocked on" and notify once.
model UserAchievement {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String   @db.Uuid
  /// Badge key from the shared catalog (e.g. "deals", "revenue").
  key        String
  /// 1-based level within the badge.
  level      Int
  /// The metric value when it was unlocked.
  value      Decimal  @db.Decimal(16, 2)
  unlockedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, level])
  @@index([tenantId, unlockedAt])
}
