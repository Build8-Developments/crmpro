{
  "info": {
    "_postman_id": "crmpro-admin-auth-collection",
    "name": "CRMPro Admin API",
    "description": "CRMPro Admin API — auth and admins modules.\n\nBase URL: {{adminBaseUrl}} = http://localhost:3100/api/v1\n\nStart with Admin Auth → Login. Tokens are saved to adminAccessToken / adminRefreshToken / adminSessionId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function getRequestPath() {",
          "  const url = pm.request.url;",
          "  if (typeof url.getPath === 'function') {",
          "    const path = url.getPath();",
          "    if (Array.isArray(path)) return path.filter(Boolean).join('/');",
          "    if (typeof path === 'string') return path.replace(/^\\/+/, '').replace(/\\/+$/, '');",
          "  }",
          "  if (Array.isArray(url.path)) return url.path.filter(Boolean).join('/');",
          "  return '';",
          "}",
          "",
          "function isPublicAuthRoute() {",
          "  return /(^|\\/)auth\\/(login|refresh)$/.test(getRequestPath());",
          "}",
          "",
          "const token = pm.environment.get('adminAccessToken');",
          "if (token && !isPublicAuthRoute()) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${token}` });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function saveAdminTokens(json) {",
          "  if (json.accessToken) pm.environment.set('adminAccessToken', json.accessToken);",
          "  if (json.refreshToken) {",
          "    pm.environment.set('adminRefreshToken', json.refreshToken);",
          "    const sessionId = json.refreshToken.split('.')[0];",
          "    if (sessionId) pm.environment.set('adminSessionId', sessionId);",
          "  }",
          "}",
          "",
          "if (pm.response.code >= 200 && pm.response.code < 300) {",
          "  try { saveAdminTokens(pm.response.json()); } catch (e) {}",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Admin Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-device-fingerprint", "value": "postman-local-dev" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{adminBaseUrl}}/auth/login"
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{adminRefreshToken}}\"\n}"
            },
            "url": "{{adminBaseUrl}}/auth/refresh"
          }
        },
