                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.data) {",
                  "  console.log(`Authenticated as ${json.data.email} (${json.data.role?.name})`);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
