    {
      "name": "Pipelines",
      "description": "Pipeline and stage management. Requires owner/manager for write operations; agents have pipeline.read only.",
      "item": [
        {
          "name": "List Pipelines",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Response has pipelines with stages', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data).to.have.property('items');",
                  "  pm.expect(json.data).to.have.property('pagination');",
                  "  pm.expect(json.data.items).to.be.an('array');",
                  "  pm.expect(json.data.pagination.page).to.eql(1);",
                  "  pm.expect(json.data.pagination.limit).to.eql(20);",
                  "  if (json.data.items.length > 0) {",
                  "    pm.expect(json.data.items[0]).to.have.property('stages');",
                  "  }",
                  "});",
                  "",
                  "if (json.data?.items?.length) {",
                  "  const commercial = json.data.items.find((p) => p.name === 'Commercial Leasing');",
                  "  const pipeline = commercial || json.data.items.find((p) => !p.isDefault) || json.data.items[0];",
                  "  pm.environment.set('pipelineId', pipeline.id);",
                  "  const openStage = pipeline.stages?.find((s) => !s.isClosed);",
                  "  if (openStage) {",
                  "    pm.environment.set('stageId', openStage.id);",
                  "  }",
                  "  console.log(`Saved pipelineId=${pipeline.id}, stageId=${openStage?.id || '(none)'}`);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pipelines?page=1&limit=20&search=sales&sortBy=createdAt&sortOrder=desc",
              "host": ["{{baseUrl}}"],
              "path": ["pipelines"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "search", "value": "sales", "description": "Case-insensitive name search" },
                { "key": "sortBy", "value": "createdAt", "description": "name | createdAt" },
                { "key": "sortOrder", "value": "desc", "description": "asc | desc" }
              ]
            },
            "description": "List tenant pipelines (paginated, searchable, sortable).\n\n**Query:** `page`, `limit` (max 100), `search` (pipeline name), `sortBy` (`name`|`createdAt`), `sortOrder` (`asc`|`desc`).\n\nDefaults: page=1, limit=20, sortBy=createdAt, sortOrder=asc."
