        {
          "name": "Get Permissions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has permissions and role', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data).to.have.property('permissions');",
                  "  pm.expect(json.data).to.have.property('role');",
                  "  pm.expect(json.data.permissions).to.be.an('array');",
                  "  pm.expect(json.data.permissions.length).to.be.above(0);",
                  "  pm.expect(json.data.role).to.have.property('id');",
                  "  pm.expect(json.data.role).to.have.property('name');",
                  "  json.data.permissions.forEach(function (key) {",
                  "    pm.expect(key).to.match(/^[a-z]+\\.[a-z]+$/);",
                  "  });",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.data) {",
                  "  console.log(`Role: ${json.data.role?.name} (${json.data.role?.id})`);",
                  "  console.log(`Permissions (${json.data.permissions.length}): ${json.data.permissions.join(', ')}`);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/permissions",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "permissions"]
            },
            "description": "Returns the authenticated user's RBAC permissions and role for the current tenant.\n\nRequires Bearer token. Use for frontend UI gating — backend routes still enforce permissions via `PermissionsGuard`.\n\n**Response shape:**\n```json\n{\n  \"success\": true,\n  \"data\": {\n    \"permissions\": [\"lead.read\", \"lead.update\"],\n    \"role\": { \"id\": \"...\", \"name\": \"Agent\" }\n  }\n}\n```"
          },
          "response": []
        },
