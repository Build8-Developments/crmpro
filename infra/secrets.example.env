# The secrets file of one environment: /srv/<project>/secrets/<environment>.env, mode 600, owned
# by the project user. Never in git. infra/deploy.sh reads it after infra/compose/<env>.env.
#
# Generated on the server (infra/server/init-secrets.sh, which leaves existing values alone):
POSTGRES_PASSWORD=
API_JWT_ACCESS_SECRET=
ADMIN_JWT_ACCESS_SECRET=
INTERNAL_MONITORING_KEY=
# Staging only: the demo seed's passwords and the platform admin's sign-in, instead of the
# development defaults that are in the repo.
SEED_USER_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Pasted in by hand (cloudflare-setup.md §6–§7):
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RESEND_API_KEY=
