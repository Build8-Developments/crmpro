# Nomow staging: settings that are not secret (deployment-plan.md §3). Secrets are in the server's
# own file (/srv/crmpro-staging/secrets/staging.env, see infra/secrets.example.env), read after
# this one, so a value there wins.
APP_ENV=staging
IMAGE_PREFIX=ghcr.io/build8-developments/crmpro
APEX_URL=https://staging.nomow.app
ADMIN_URL=https://admin-staging.nomow.app
ADMIN_HOST=admin-staging.nomow.app
WORKSPACE_URL_TEMPLATE=https://{slug}-staging.nomow.app
NOINDEX=true

# Heaps sized to the containers in compose.staging.yml.
API_NODE_OPTIONS=--max-old-space-size=576
ADMIN_API_NODE_OPTIONS=--max-old-space-size=288

# Real mail through Resend (cloudflare-setup.md §7), so demo invites and resets work.
MAIL_FROM=Nomow Staging <no-reply@mail.nomow.app>
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend

# Cloudflare R2 (cloudflare-setup.md §6); R2_ACCOUNT_ID is in the secrets file. The staging
# bucket is in R2's EU jurisdiction, which has its own S3 endpoint.
R2_ENDPOINT_HOST=eu.r2.cloudflarestorage.com
AWS_REGION=auto
AWS_S3_BUCKET=crmpro-staging-files

# The seed's demo workspace, used by the deploy's smoke tests.
SMOKE_WORKSPACE=prime-estates
